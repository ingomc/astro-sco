---
import { getCollection } from 'astro:content';
import { getContentCollection, type ContentEntry } from '../../lib/content-source';
import { canRenderDirectusMarkdown, renderMarkdownToHtml } from '../../lib/body-content';
import EventPost from '../../layouts/EventPost.astro';

export async function getStaticPaths() {
	const allBerichte = await getContentCollection('berichte');
	const allVeranstaltungen = (await getContentCollection('veranstaltungen')).filter((ev) => ev.data.pubDate <= new Date());

	return allBerichte.map((event) => {
		const tags = event.data.tags ?? [];
		const related = tags.length > 0
			? [
				...allBerichte.filter(
					(b) => b.slug !== event.slug && (b.data.tags ?? []).some((t) => tags.includes(t))
				),
				...allVeranstaltungen.filter(
					(ev) => (ev.data.tags ?? []).some((t) => tags.includes(t))
				),
			].sort((a, b) => b.data.eventDate.getTime() - a.data.eventDate.getTime())
			: [];
		return {
			params: { slug: event.slug },
			props: { event, relatedItems: related },
		};
	});
}

type Props = {
	event: ContentEntry<'berichte'>;
	relatedItems: (ContentEntry<'berichte'> | ContentEntry<'veranstaltungen'>)[];
};

const { event, relatedItems } = Astro.props;
const markdownBody = canRenderDirectusMarkdown(event)
	? event.body || ""
	: null;
const markdownHtml = markdownBody ? await renderMarkdownToHtml(markdownBody) : null;

let rendered = null;
if (!markdownHtml) {
	const astroEntries = await getCollection('berichte');
	const astroEntry = astroEntries.find((entry) => entry.slug === event.slug);
	rendered = astroEntry ? await astroEntry.render() : null;
}


---

<EventPost {...event.data} relatedItems={relatedItems}>
	{
		markdownHtml ? (
			<Fragment set:html={markdownHtml} />
		) : rendered ? (
			<rendered.Content />
		) : (
			<p>{event.data.description ?? ""}</p>
		)
	}
</EventPost>
