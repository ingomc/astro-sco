---
import App from "../../layouts/App.astro";
---

<App
  title="Danke für deine Dart-Anmeldung – SCO-OGV Oberfüllbach"
  description="Bestätigung deiner Anmeldung zum offenen Dart-Sonntagstraining."
  robots="noindex,nofollow"
>
  <section class="relative isolate overflow-hidden bg-slate-950 text-white">
    <div
      class="pointer-events-none absolute -right-20 -top-32 h-80 w-80 rounded-full border-[44px] border-red-700/25 sm:h-[28rem] sm:w-[28rem]"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute -bottom-24 right-28 h-48 w-48 rounded-full border-[22px] border-white/10"
      aria-hidden="true"
    >
    </div>

    <div class="container relative mx-auto px-4 pb-20 pt-10 md:pb-28 md:pt-14">
      <a
        href="/darts/"
        class="inline-flex items-center gap-2 text-sm font-semibold text-slate-300 underline-offset-4 hover:text-white hover:underline"
      >
        <span aria-hidden="true">←</span> Zur Dart-Abteilung
      </a>

      <div class="mt-11 grid items-center gap-10 md:grid-cols-[1fr_auto]">
        <div class="max-w-2xl">
          <p
            class="inline-flex items-center gap-2 rounded-full border border-red-400/40 bg-red-950/60 px-3 py-1.5 text-sm font-bold text-red-100"
          >
            <span class="h-2 w-2 rounded-full bg-red-400" aria-hidden="true"
            ></span>
            SCO-Darts · Offenes Sonntagstraining
          </p>
          <h1
            class="mt-5 text-4xl font-extrabold tracking-tight sm:text-5xl md:text-6xl"
            data-dart-confirmation-title
          >
            Deine Dart-Anmeldung
          </h1>
          <p
            class="mt-4 max-w-xl text-lg leading-relaxed text-slate-300"
            data-dart-confirmation-intro
            aria-live="polite"
          >
            Wir laden deine Bestätigung …
          </p>
        </div>

        <div
          class="relative mx-auto flex h-44 w-44 items-center justify-center rounded-full border-[18px] border-red-700 bg-slate-800 shadow-[0_0_0_16px_rgba(255,255,255,0.06)] md:mr-8 md:h-52 md:w-52"
          aria-hidden="true"
        >
          <div
            class="flex h-28 w-28 items-center justify-center rounded-full border-[16px] border-white/80 bg-red-700 text-6xl font-bold text-white md:h-36 md:w-36"
          >
            ✓
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="container relative mx-auto -mt-10 px-4 pb-14 md:-mt-14 md:pb-20">
    <section
      class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xl sm:p-8 md:p-10"
      data-dart-confirmation
      hidden
      aria-labelledby="dart-confirmation-details-title"
    >
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <p class="text-sm font-bold uppercase tracking-wide text-red-700">
            Alles auf einen Blick
          </p>
          <h2
            id="dart-confirmation-details-title"
            class="mt-1 text-2xl font-bold text-slate-950"
          >
            Dein nächster Dart-Sonntag
          </h2>
        </div>
        <span
          class="rounded-full bg-emerald-100 px-3 py-1.5 text-sm font-bold text-emerald-900"
        >
          Anmeldung eingegangen
        </span>
      </div>

      <div class="mt-7 grid gap-4 sm:grid-cols-2">
        <div class="rounded-2xl bg-slate-50 p-5">
          <p
            class="text-sm font-semibold uppercase tracking-wide text-slate-500"
          >
            Wann
          </p>
          <p
            class="mt-2 text-xl font-bold leading-snug text-slate-950"
            data-dart-confirmation-slot
          >
          </p>
        </div>
        <div class="rounded-2xl bg-slate-50 p-5">
          <p
            class="text-sm font-semibold uppercase tracking-wide text-slate-500"
          >
            Wo
          </p>
          <p class="mt-2 text-xl font-bold text-slate-950">
            Sportheim Oberfüllbach
          </p>
          <a
            href="/sportheim/"
            class="mt-2 inline-block text-sm font-semibold text-red-800 underline underline-offset-4 hover:text-red-950"
          >
            Zum Sportheim
          </a>
        </div>
      </div>

      <div class="mt-5 rounded-2xl border border-red-200 bg-red-50 p-5">
        <p class="text-sm font-bold uppercase tracking-wide text-red-800">
          Deine Anmeldenummer
        </p>
        <div class="mt-2 flex flex-wrap items-center gap-4">
          <strong
            class="break-all font-mono text-2xl tracking-wide text-slate-950"
            data-dart-confirmation-id></strong>
          <button
            type="button"
            class="rounded-full border border-red-300 bg-white px-4 py-2 text-sm font-bold text-red-900 transition hover:bg-red-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-700 focus-visible:ring-offset-2"
            data-dart-confirmation-copy
            hidden
          >
            Nummer kopieren
          </button>
        </div>
        <p class="mt-2 text-sm text-slate-700">
          Heb sie für Rückfragen am besten auf.
        </p>
        <p
          class="mt-2 text-sm font-semibold text-emerald-900"
          data-dart-confirmation-copy-status
          aria-live="polite"
        >
        </p>
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/darts/"
          class="inline-flex items-center justify-center rounded-full bg-red-700 px-5 py-3 font-bold text-white transition hover:bg-red-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-700 focus-visible:ring-offset-2"
        >
          Zur Dart-Abteilung
        </a>
        <a
          href="/"
          class="inline-flex items-center justify-center rounded-full border border-slate-300 px-5 py-3 font-bold text-slate-800 transition hover:bg-slate-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-700 focus-visible:ring-offset-2"
        >
          Zur Startseite
        </a>
      </div>
    </section>

    <section
      class="rounded-3xl border border-slate-200 bg-white p-6 shadow-xl sm:p-8 md:p-10"
      data-dart-confirmation-empty
      hidden
      aria-labelledby="dart-confirmation-empty-title"
    >
      <h2
        id="dart-confirmation-empty-title"
        class="text-2xl font-bold text-slate-950"
      >
        Keine Bestätigung gefunden
      </h2>
      <p class="mt-3 max-w-2xl text-slate-700">
        Diese Seite zeigt die Bestätigung direkt nach einer erfolgreichen
        Anmeldung. Wenn du dich anmelden möchtest, nutze bitte das Formular.
      </p>
      <a
        href="/darts/anmelden/"
        class="mt-6 inline-flex items-center justify-center rounded-full bg-red-700 px-5 py-3 font-bold text-white transition hover:bg-red-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-700 focus-visible:ring-offset-2"
      >
        Zum Anmeldeformular
      </a>
    </section>
  </div>
</App>

<script>
  const storageKey = "sco-dart-open-play-confirmation";
  const title = document.querySelector("[data-dart-confirmation-title]");
  const intro = document.querySelector("[data-dart-confirmation-intro]");
  const confirmation = document.querySelector("[data-dart-confirmation]");
  const empty = document.querySelector("[data-dart-confirmation-empty]");
  const slot = document.querySelector("[data-dart-confirmation-slot]");
  const registrationId = document.querySelector("[data-dart-confirmation-id]");
  const copyButton = document.querySelector("[data-dart-confirmation-copy]");
  const copyStatus = document.querySelector(
    "[data-dart-confirmation-copy-status]",
  );

  let saved;
  try {
    saved = JSON.parse(sessionStorage.getItem(storageKey) || "null");
  } catch {
    saved = null;
  }

  if (
    saved &&
    typeof saved.registrationId === "string" &&
    saved.registrationId.length > 0 &&
    typeof saved.slotLabel === "string" &&
    saved.slotLabel.length > 0 &&
    confirmation instanceof HTMLElement &&
    slot instanceof HTMLElement &&
    registrationId instanceof HTMLElement
  ) {
    slot.textContent = saved.slotLabel;
    registrationId.textContent = saved.registrationId;
    confirmation.hidden = false;
    if (title instanceof HTMLElement) title.textContent = "Du bist dabei!";
    if (intro instanceof HTMLElement) {
      intro.textContent =
        "Deine Anmeldung ist eingegangen. Wir freuen uns auf dich am Board!";
    }

    if (
      copyButton instanceof HTMLButtonElement &&
      navigator.clipboard?.writeText
    ) {
      copyButton.hidden = false;
      copyButton.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(saved.registrationId);
          if (copyStatus instanceof HTMLElement) {
            copyStatus.textContent = "Anmeldenummer kopiert.";
          }
        } catch {
          if (copyStatus instanceof HTMLElement) {
            copyStatus.textContent =
              "Kopieren nicht möglich – bitte die Nummer markieren.";
          }
        }
      });
    }
  } else {
    if (empty instanceof HTMLElement) empty.hidden = false;
    if (title instanceof HTMLElement)
      title.textContent = "Deine Dart-Anmeldung";
    if (intro instanceof HTMLElement) {
      intro.textContent = "Hier liegt gerade keine Anmeldebestätigung vor.";
    }
  }
</script>
