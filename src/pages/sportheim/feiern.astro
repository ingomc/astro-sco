---
import App from "../../layouts/App.astro";
import HpStage from "../../components/HpStage.astro";
import { getVenueContacts } from "../../lib/venue-contacts";

const contacts = getVenueContacts();
---

<App
  title="Feiern & Räume - SCO & OGV Oberfüllbach"
  description="Sportheim für private Feiern anfragen und Möglichkeiten für den Dartraum besprechen"
>
  <HpStage image="/src/media/buehne-sportheim.jpg" title="Feiern & Räume" />
  <div
    class="container mx-auto grid gap-8 px-4 py-10 lg:grid-cols-[minmax(0,2fr)_minmax(18rem,1fr)]"
  >
    <div class="prose max-w-none">
      <h2>Private Feiern im Sportheim</h2>
      <p>
        Ob Geburtstag, Familienfeier oder ein anderer Anlass: Unser Sportheim
        kann für private Feiern angefragt werden. Sprechen Sie mit unseren
        Vorständen über Ihren Wunschtermin und Ihre Pläne.
      </p>
      <h2>Dartraum nach Rücksprache</h2>
      <p>
        Wenn Sie den Dartraum nutzen möchten, fragen Sie bitte ebenfalls bei den
        Vorständen an. Ob und wie das möglich ist, klären wir gemeinsam im
        Gespräch.
      </p>
      <p>
        Nennen Sie bei der Anfrage am besten Anlass, Wunschtermin und die
        ungefähre Personenzahl. Alle weiteren Details besprechen wir
        individuell.
      </p>
      <a href="/sportheim" class="font-semibold text-red-800"
        >Anschrift und Öffnungszeiten ansehen</a
      >
    </div>

    <aside
      class="h-fit rounded-xl border border-slate-200 bg-white p-6 shadow-sm"
      aria-labelledby="venue-contact-title"
    >
      <h2 id="venue-contact-title" class="text-xl font-bold text-slate-900">
        Raum anfragen
      </h2>
      {
        contacts.length === 2 ? (
          <div class="mt-4 grid gap-5">
            {contacts.map((contact) => (
              <div class="border-t border-slate-200 pt-4 first:border-0 first:pt-0">
                <h3 class="font-semibold">{contact.name}</h3>
                <p class="text-sm text-slate-600">{contact.role}</p>
                <p class="mt-1 text-sm text-slate-600">{contact.phone}</p>
                <div class="mt-3 flex flex-wrap gap-2">
                  <a
                    href={contact.whatsappUrl}
                    class="rounded-full bg-red-700 px-4 py-2 text-sm font-semibold text-white hover:bg-red-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-700 focus-visible:ring-offset-2"
                  >
                    WhatsApp
                  </a>
                  <a
                    href={contact.smsUrl}
                    class="rounded-full border border-red-700 px-4 py-2 text-sm font-semibold text-red-800 hover:bg-red-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-700 focus-visible:ring-offset-2"
                  >
                    SMS
                  </a>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <p class="mt-3 text-slate-700">
            Die Mobilkontakte unserer Vorstände werden hier ergänzt. Bis dahin
            erreichen Sie das Sportheim unter{" "}
            <a
              class="font-semibold text-red-800 underline"
              href="tel:+4995608609"
            >
              09560 / 8609
            </a>
            .
          </p>
        )
      }
    </aside>
  </div>
</App>
