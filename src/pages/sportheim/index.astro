---
import Button from "../../components/Button.astro";
import {
  getContentCollection,
  getSiteSettings,
} from "../../lib/content-source";
import { renderDirectusBodyToHtml } from "../../lib/body-content";
import App from "../../layouts/App.astro";
import HpStage from "../../components/HpStage.astro";
import VisitInfo from "../../components/VisitInfo.astro";

const posts = (await getContentCollection("sportheim"))
  .filter(
    (post) =>
      ![post.slug, post.data.legacyId].some(
        (id) => id?.replace(/\.md$/, "") === "oeffnungszeiten",
      ),
  )
  .sort(
    (a, b) =>
      (a.data.order ?? Number.MAX_SAFE_INTEGER) -
      (b.data.order ?? Number.MAX_SAFE_INTEGER),
  );

const renderedPosts = await Promise.all(
  posts.map(async (post) => {
    const html = await renderDirectusBodyToHtml(post);
    return {
      slug: post.slug,
      html,
    };
  }),
);

const settings = await getSiteSettings();

const title = "Besuch & Öffnungszeiten - SCO & OGV Oberfüllbach";
const description =
  "Überblick über Aktivitäten in und um unser Sportheim in Oberfüllbach.";
---

<App title={title} description={description}>
  <HpStage
    image="/src/media/buehne-sportheim.jpg"
    blurred="data:image/webp;base64,"
    title="Besuch & Öffnungszeiten"
  />
  <div class="container mx-auto px-4 py-8 md:py-12">
    <p class="mb-8 max-w-3xl text-lg leading-relaxed text-slate-700">
      Unser Sportheim ist Treffpunkt für das Vereinsleben in Oberfüllbach. Hier
      finden das offene Dart-Training und private Feiern nach Absprache statt.
      Öffnungszeiten, Anfahrt und die Angebote im Haus finden Sie auf dieser
      Seite.
    </p>
    <VisitInfo settings={settings} />
    <section class="prose mt-10 max-w-3xl">
      {
        renderedPosts.map(
          (post) => post.html && <Fragment set:html={post.html} />,
        )
      }
    </section>
    <nav aria-label="Sportheim und Angebote" class="mt-6 flex flex-wrap gap-3">
      <Button variant="primary" href="/darts/training"
        >Zum offenen Dart-Training</Button
      >
      <Button variant="secondary" href="/sportheim/feiern"
        >Feier anfragen</Button
      >
    </nav>
  </div>
</App>
