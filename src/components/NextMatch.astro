---
// NextMatch.astro - Zeigt das nächste Ligaspiel dynamisch von der 2K API
interface Props {
  small?: boolean;
  header?: boolean;
}

const { small = false, header = false } = Astro.props;
---

<div
  class={`next-match-container group relative ${small ? `block w-full ${header ? "rounded-full transition-colors duration-200 hover:bg-slate-100" : ""}` : "bg-white rounded-lg px-4 py-3 border border-slate-300"}`}
  data-small={small ? "true" : "false"}
  data-header={header ? "true" : "false"}
>
  {
    small && (
      <a
        href="/darts"
        class:list={[
          "peer absolute inset-0 z-10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-700 focus-visible:ring-offset-2",
          header ? "rounded-full" : "rounded-md",
        ]}
        aria-label="Nächstes Dartspiel und Spielplan ansehen"
      >
        <span class="sr-only">Zur Darts-Mannschaftsseite</span>
      </a>
    )
  }

  {/* Standard View */}
  {
    !small && (
      <>
        <div class="flex gap-2 justify-between items-center mb-2">
          <h2 id="next-match-heading" class="font-bold">
            Nächstes Ligaspiel
          </h2>
          <span class="home-away-badge text-xs py-1 px-2 rounded-full hidden" />
        </div>
        <hr class="mb-3" />
      </>
    )
  }

  <div class="next-match-content" aria-live="polite">
    <div class="loading-state py-4 text-center text-slate-500">
      {
        small ? (
          <span class="animate-pulse text-xs">...</span>
        ) : (
          <>
            <svg
              class="animate-spin h-5 w-5 mx-auto mb-2"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
            >
              <circle
                class="opacity-25"
                cx="12"
                cy="12"
                r="10"
                stroke="currentColor"
                stroke-width="4"
              />
              <path
                class="opacity-75"
                fill="currentColor"
                d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
              />
            </svg>
            Lade Spielplan...
          </>
        )
      }
    </div>

    <div class="match-info hidden">
      {
        small ? (
          <div
            class:list={[
              "flex min-h-10 w-full items-center py-1.5",
              header ? "justify-start px-3 pr-11" : "justify-center px-11",
            ]}
          >
            <div
              class:list={[
                "flex min-w-0 items-center text-slate-700",
                header ? "gap-2" : "gap-1.5",
              ]}
            >
              <span
                class:list={[
                  "home-away-badge hidden rounded-full py-0.5 font-bold uppercase",
                  header
                    ? "px-2 text-[10px] tracking-wider"
                    : "px-1.5 text-[9px] tracking-wide",
                ]}
              />
              <div class="flex min-w-0 items-center gap-1.5 leading-tight">
                <span class="shrink-0 font-bold date-short text-xs" />
                <span class="text-slate-600 text-xs">vs</span>
                <span class="opponent-team max-w-[7rem] truncate text-xs font-semibold 2xl:max-w-[11rem]" />
              </div>
            </div>
          </div>
        ) : (
          <div class="flex flex-col gap-2">
            {/* Datum und Uhrzeit */}
            <div class="flex items-center gap-2">
              <span class="date-badge text-xs font-semibold py-1 px-2 rounded-full bg-slate-100" />
              <span class="time-text text-sm text-slate-600" />
            </div>

            {/* Teams */}
            <div class="flex flex-col gap-1 mt-1">
              <div class="flex items-center justify-between gap-2 text-sm">
                <span class="home-team font-semibold flex-1 truncate" />
                <span class="text-slate-600">vs</span>
                <span class="guest-team font-semibold flex-1 truncate text-right" />
              </div>
            </div>

            {/* Spieltag Info */}
            <div class="text-xs text-slate-500 mt-1">
              <span class="round-name" />
            </div>
          </div>
        )
      }
    </div>

    <div class="no-match-state hidden py-4 text-center text-slate-500">
      {small ? "" : "Kein anstehendes Spiel gefunden"}
    </div>

    <div class="error-state hidden py-4 text-center text-red-500">
      {small ? "!" : "Fehler beim Laden der Daten"}
    </div>
  </div>

  {
    small && (
      <span
        class="pointer-events-none absolute right-2 top-1/2 z-20 inline-flex h-7 w-7 -translate-y-1/2 items-center justify-center rounded-full bg-red-700 text-white shadow-sm transition-colors group-hover:bg-red-800 peer-focus-visible:ring-2 peer-focus-visible:ring-red-700 peer-focus-visible:ring-offset-2"
        aria-hidden="true"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 256 256"
          fill="currentColor"
        >
          <path d="m221.66 133.66-72 72a8 8 0 0 1-11.32-11.32L196.69 136H40a8 8 0 0 1 0-16h156.69l-58.35-58.34a8 8 0 0 1 11.32-11.32l72 72a8 8 0 0 1 0 11.32Z" />
        </svg>
      </span>
    )
  }
</div>

<script>
  import {
    formatDartDate,
    formatDartTime,
    getDartTeamData,
    type DartMatch,
  } from "../lib/darts";

  function updateNextMatch(container: HTMLElement, match: DartMatch) {
    const isSmall = container.dataset.small === "true";
    const isHeader = container.dataset.header === "true";
    const loadingEl = container.querySelector<HTMLElement>(".loading-state");
    const matchInfoEl = container.querySelector<HTMLElement>(".match-info");
    const badgeEl = container.querySelector<HTMLElement>(".home-away-badge");
    const formattedDate = formatDartDate(match.datePlanned);
    const formattedTime = formatDartTime(match.datePlanned);

    loadingEl?.classList.add("hidden");
    matchInfoEl?.classList.remove("hidden");

    if (badgeEl) {
      const badgeText = match.isHome ? "Heimspiel" : "Auswärts";
      badgeEl.textContent = isSmall
        ? `🎯 ${badgeText}`
        : match.isHome
          ? "🏠 Heimspiel"
          : "🚗 Auswärts";
      badgeEl.className = isSmall
        ? `home-away-badge rounded-full border py-0.5 font-bold uppercase ${isHeader ? "mr-1 px-2 text-[10px] tracking-wider" : "px-1.5 text-[9px] tracking-wide"} ${match.isHome ? "border-green-200 bg-green-100 text-green-800" : "border-blue-200 bg-blue-100 text-blue-800"}`
        : `home-away-badge text-xs py-1 px-2 rounded-full ${match.isHome ? "bg-green-100 text-green-800" : "bg-blue-100 text-blue-800"}`;
    }

    if (!matchInfoEl) return;

    if (isSmall) {
      const dateEl = matchInfoEl.querySelector<HTMLElement>(".date-short");
      const opponentEl =
        matchInfoEl.querySelector<HTMLElement>(".opponent-team");
      if (dateEl) dateEl.textContent = `${formattedDate}, ${formattedTime}`;
      if (opponentEl) opponentEl.textContent = match.opponent;
      return;
    }

    const dateEl = matchInfoEl.querySelector<HTMLElement>(".date-badge");
    const timeEl = matchInfoEl.querySelector<HTMLElement>(".time-text");
    const homeEl = matchInfoEl.querySelector<HTMLElement>(".home-team");
    const guestEl = matchInfoEl.querySelector<HTMLElement>(".guest-team");
    const roundEl = matchInfoEl.querySelector<HTMLElement>(".round-name");

    if (dateEl) dateEl.textContent = formattedDate;
    if (timeEl) timeEl.textContent = `${formattedTime} Uhr`;
    if (homeEl) {
      homeEl.textContent = match.homeTeam;
      homeEl.classList.toggle("text-red-700", match.isHome);
    }
    if (guestEl) {
      guestEl.textContent = match.guestTeam;
      guestEl.classList.toggle("text-red-700", !match.isHome);
    }
    if (roundEl) roundEl.textContent = match.roundName;
  }

  async function initNextMatch(container: HTMLElement) {
    if (container.dataset.initialized === "true") return;
    container.dataset.initialized = "true";

    try {
      const data = await getDartTeamData();

      if (data.nextMatch) {
        updateNextMatch(container, data.nextMatch);
        return;
      }

      container.querySelector(".loading-state")?.classList.add("hidden");
      container.querySelector(".no-match-state")?.classList.remove("hidden");
    } catch (error) {
      console.error("Fehler beim Laden des nächsten Dartspiels:", error);
      container.querySelector(".loading-state")?.classList.add("hidden");
      container.querySelector(".error-state")?.classList.remove("hidden");
    }
  }

  document
    .querySelectorAll<HTMLElement>(".next-match-container")
    .forEach(initNextMatch);
</script>
