---
type Props = {
  apiUrl?: string;
};

const { apiUrl = "" } = Astro.props;
const normalizedApiUrl = apiUrl.trim().replace(/\/+$/, "");
---

<section
  class="not-prose rounded-2xl border border-red-200 bg-red-50 p-5 shadow-sm md:p-6"
  data-dart-training-callout
  data-api-url={normalizedApiUrl}
  aria-labelledby="dart-training-callout-title"
>
  <div
    class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between"
  >
    <div class="max-w-2xl">
      <p class="text-sm font-bold uppercase tracking-wide text-red-700">
        Gäste willkommen
      </p>
      <h2
        id="dart-training-callout-title"
        class="mt-1 text-2xl font-bold text-slate-950"
      >
        Offenes Sonntagstraining
      </h2>
      <p class="mt-2 text-slate-700">
        Jeden Sonntag ab <span data-dart-training-time>18:00 Uhr</span> im Sportheim
        Oberfüllbach. Ob Einsteiger oder erfahrener Spieler: Komm vorbei und spiel
        mit.
      </p>
      <p class="mt-2 text-slate-700">
        Wir haben fünf Dartscheiben. Eigene Pfeile brauchst du nicht: Du kannst
        beim offenen Training kostenlos welche ausleihen und unsere Darts
        ausprobieren.
      </p>
      <p
        class="mt-3 text-sm font-semibold text-slate-800"
        data-dart-training-status
        aria-live="polite"
      >
        Der nächste Termin wird geladen …
      </p>
    </div>
    <a
      class="inline-flex shrink-0 items-center justify-center rounded-full bg-red-700 px-5 py-3 text-center font-bold text-white shadow-sm transition hover:bg-red-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-700 focus-visible:ring-offset-2"
      href="/darts/anmelden/"
      data-dart-training-link
    >
      Für nächsten Sonntag anmelden
    </a>
  </div>
</section>

<script>
  function readJson(response) {
    return response.json().catch(() => ({}));
  }

  async function initialiseCallout(root) {
    if (!(root instanceof HTMLElement)) return;

    const apiUrl = root.dataset.apiUrl;
    const status = root.querySelector("[data-dart-training-status]");
    const time = root.querySelector("[data-dart-training-time]");
    const link = root.querySelector("[data-dart-training-link]");
    if (!(status instanceof HTMLElement)) return;

    if (!apiUrl) {
      status.textContent = "Die Online-Anmeldung wird gerade eingerichtet.";
      return;
    }

    try {
      const response = await fetch(apiUrl, {
        headers: { Accept: "application/json" },
      });
      const result = await readJson(response);
      if (!response.ok) {
        throw new Error(
          result.message || "Der Termin konnte nicht geladen werden.",
        );
      }

      if (
        typeof result?.slot?.time === "string" &&
        time instanceof HTMLElement
      ) {
        time.textContent = `${result.slot.time} Uhr`;
      }

      if (result.open && typeof result?.slot?.label === "string") {
        status.textContent = `Nächster Termin: ${result.slot.label}`;
        return;
      }

      status.textContent =
        result.message ||
        "Die Online-Anmeldung ist für den nächsten Termin aktuell nicht geöffnet.";
      if (link instanceof HTMLAnchorElement) {
        link.hidden = true;
      }
    } catch {
      status.textContent =
        "Die Online-Anmeldung ist gerade nicht erreichbar. Bitte versuche es später erneut.";
    }
  }

  document
    .querySelectorAll("[data-dart-training-callout]")
    .forEach((root) => initialiseCallout(root));
</script>
