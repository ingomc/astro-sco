---
interface Props {
  eventSlug: string;
  apiUrl?: string;
}

const { eventSlug, apiUrl } = Astro.props;
const normalizedApiUrl = apiUrl?.replace(/\/$/, "");
---

{
  normalizedApiUrl && (
    <section
      class="food-preorder not-prose my-8 rounded-xl border border-red-200 bg-red-50/60 p-4 shadow-sm md:p-6"
      data-food-preorder
      data-api-url={normalizedApiUrl}
      data-event-slug={eventSlug}
      aria-labelledby={`food-preorder-title-${eventSlug}`}
      hidden
    >
      <h2
        id={`food-preorder-title-${eventSlug}`}
        class="mb-2 text-2xl font-bold text-red-950"
      >
        Essen vorbestellen
      </h2>
      <p class="food-preorder-status text-slate-700" aria-live="polite">
        Lade Essensauswahl …
      </p>
      <div class="food-preorder-content" />
      <noscript>
        <p class="mt-3 text-slate-700">
          Für die Essensvorbestellung wird JavaScript benötigt.
        </p>
      </noscript>
    </section>
  )
}

<script>
  const escapeHtml = (value) =>
    String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");

  const asCurrency = (cents) =>
    new Intl.NumberFormat("de-DE", {
      style: "currency",
      currency: "EUR",
    }).format(Number(cents || 0) / 100);

  const endpoint = (apiUrl, path) => `${apiUrl.replace(/\/$/, "")}${path}`;

  async function request(apiUrl, path, options = {}) {
    const response = await fetch(endpoint(apiUrl, path), {
      headers: {
        ...(options.body ? { "Content-Type": "application/json" } : {}),
        ...(options.headers || {}),
      },
      ...options,
    });
    const payload = await response.json().catch(() => ({}));
    if (!response.ok) {
      const error = new Error(
        payload.message || "Die Anfrage konnte nicht verarbeitet werden.",
      );
      error.code = payload.error;
      throw error;
    }
    return payload;
  }

  function renderOrderForm(root, state) {
    const { ordering, reservation, mode } = state;
    const content = root.querySelector(".food-preorder-content");
    const status = root.querySelector(".food-preorder-status");
    const selectedByDish = new Map(
      (reservation?.lines || []).map((line) => [
        Number(line.dishId),
        Number(line.quantity),
      ]),
    );
    const dishes = ordering.dishes || [];

    root.hidden = false;
    status.textContent =
      mode === "manage"
        ? `Reservierung ${reservation.reservationNumber} verwalten`
        : "Wähle die gewünschten Gerichte aus. Bezahlt wird bei der Abholung vor Ort.";

    if (ordering.closed || dishes.length === 0) {
      content.innerHTML = `<p class="mt-3 rounded-lg bg-white p-3 text-slate-700">Die Essensvorbestellung ist derzeit nicht verfügbar.</p>`;
      return;
    }

    const dishRows = dishes
      .map((dish) => {
        const selected = selectedByDish.get(Number(dish.id)) || 0;
        const unavailable =
          Number(dish.remainingQuantity) <= 0 && selected === 0;
        return `
        <li class="food-preorder-dish rounded-lg border border-slate-200 bg-white p-4">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <div class="min-w-0">
              <h3 class="m-0 text-lg font-bold text-slate-950">${escapeHtml(dish.name)}</h3>
              ${dish.description ? `<p class="mb-0 mt-1 text-sm text-slate-700">${escapeHtml(dish.description)}</p>` : ""}
              ${dish.allergens ? `<p class="mb-0 mt-2 text-sm text-slate-600"><strong>Allergene:</strong> ${escapeHtml(dish.allergens)}</p>` : ""}
              <p class="mb-0 mt-2 font-semibold text-slate-900">${asCurrency(dish.priceCents)}</p>
              ${unavailable ? `<p class="mb-0 mt-1 text-sm font-semibold text-red-700">Ausverkauft</p>` : ""}
            </div>
            <label class="shrink-0 text-sm font-semibold text-slate-800" for="food-quantity-${dish.id}">
              Menge
              <input
                id="food-quantity-${dish.id}"
                class="mt-1 block w-20 rounded border border-slate-300 px-2 py-1 text-base"
                type="number"
                inputmode="numeric"
                min="0"
                max="50"
                value="${selected}"
                data-dish-id="${dish.id}"
                data-price-cents="${dish.priceCents}"
                ${unavailable ? "disabled" : ""}
              />
            </label>
          </div>
        </li>`;
      })
      .join("");

    const deadline = new Intl.DateTimeFormat("de-DE", {
      dateStyle: "medium",
      timeStyle: "short",
    }).format(new Date(ordering.orderDeadline));
    content.innerHTML = `
      ${ordering.note ? `<p class="mt-3 rounded-lg bg-amber-50 p-3 text-sm text-amber-950">${escapeHtml(ordering.note)}</p>` : ""}
      <p class="mt-3 text-sm text-slate-700"><strong>Bestellschluss:</strong> ${escapeHtml(deadline)} Uhr</p>
      <form class="food-preorder-form mt-4" novalidate>
        <ul class="m-0 grid list-none gap-3 p-0">${dishRows}</ul>
        <p class="food-preorder-total mt-4 rounded-lg bg-white p-3 font-bold text-slate-950" aria-live="polite"></p>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          <label class="text-sm font-semibold text-slate-800" for="food-name">
            Name
            <input id="food-name" name="name" class="mt-1 block w-full rounded border border-slate-300 px-3 py-2 text-base" autocomplete="name" maxlength="120" required value="${escapeHtml(reservation?.name || "")}" />
          </label>
          <label class="text-sm font-semibold text-slate-800" for="food-email">
            E-Mail-Adresse
            <input id="food-email" name="email" type="email" class="mt-1 block w-full rounded border border-slate-300 px-3 py-2 text-base" autocomplete="email" maxlength="255" required value="${escapeHtml(reservation?.email || "")}" />
          </label>
        </div>
        <div class="food-preorder-honeypot" aria-hidden="true">
          <label>Website <input name="website" tabindex="-1" autocomplete="off" /></label>
        </div>
        <label class="mt-4 flex items-start gap-2 text-sm text-slate-800" for="food-privacy">
          <input id="food-privacy" name="privacy" type="checkbox" class="mt-1" required />
          <span>Ich habe die <a class="underline" href="/datenschutz">Datenschutzhinweise zur Essensvorbestellung</a> gelesen.</span>
        </label>
        <div class="mt-5 flex flex-wrap gap-3">
          <button class="rounded bg-red-700 px-4 py-2 font-bold text-white hover:bg-red-800 disabled:cursor-not-allowed disabled:bg-slate-400" type="submit">
            ${mode === "manage" ? "Änderungen speichern" : "Reservierung anfragen"}
          </button>
          ${mode === "manage" ? `<button class="food-preorder-cancel rounded border border-red-700 bg-white px-4 py-2 font-bold text-red-800 hover:bg-red-100" type="button">Reservierung stornieren</button>` : ""}
        </div>
        <p class="food-preorder-message mt-3 text-sm" aria-live="polite"></p>
      </form>`;

    const form = content.querySelector(".food-preorder-form");
    const message = form.querySelector(".food-preorder-message");
    const submitButton = form.querySelector('button[type="submit"]');
    const updateTotal = () => {
      const inputs = [...form.querySelectorAll("[data-dish-id]")];
      const total = inputs.reduce((sum, input) => {
        const quantity = Math.max(0, Number(input.value) || 0);
        return sum + quantity * Number(input.dataset.priceCents || 0);
      }, 0);
      form.querySelector(".food-preorder-total").textContent =
        `Gesamtbetrag bei Abholung: ${asCurrency(total)}`;
    };
    form
      .querySelectorAll("[data-dish-id]")
      .forEach((input) => input.addEventListener("input", updateTotal));
    updateTotal();

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const formData = new FormData(form);
      const items = [...form.querySelectorAll("[data-dish-id]")]
        .map((input) => ({
          dishId: Number(input.dataset.dishId),
          quantity: Number(input.value) || 0,
        }))
        .filter((item) => item.quantity > 0);
      const body = {
        name: formData.get("name"),
        email: formData.get("email"),
        website: formData.get("website"),
        privacyAccepted: formData.get("privacy") === "on",
        items,
      };
      submitButton.disabled = true;
      message.className = "food-preorder-message mt-3 text-sm text-slate-700";
      message.textContent = "Speichere …";
      try {
        const result =
          mode === "manage"
            ? await request(
                state.apiUrl,
                `/reservations/${encodeURIComponent(state.token)}`,
                { method: "PATCH", body: JSON.stringify(body) },
              )
            : await request(
                state.apiUrl,
                `/events/${encodeURIComponent(state.slug)}/reservations`,
                { method: "POST", body: JSON.stringify(body) },
              );
        message.className =
          "food-preorder-message mt-3 text-sm font-semibold text-green-800";
        message.textContent = result.message;
        if (result.testConfirmationToken) {
          const confirmation = await request(
            state.apiUrl,
            `/reservations/confirm/${encodeURIComponent(result.testConfirmationToken)}`,
            { method: "POST" },
          );
          const url = new URL(window.location.href);
          url.searchParams.set(
            "food-order-token",
            confirmation.managementToken,
          );
          url.searchParams.delete("food-order-confirm");
          window.history.replaceState({}, "", url);
          const management = await request(
            state.apiUrl,
            `/reservations/${encodeURIComponent(confirmation.managementToken)}`,
          );
          renderOrderForm(root, {
            apiUrl: state.apiUrl,
            slug: state.slug,
            token: confirmation.managementToken,
            ordering: management.ordering,
            reservation: management.reservation,
            mode: "manage",
          });
          return;
        }
        if (result.requiresConfirmation) {
          content.innerHTML = `<p class="mt-3 rounded-lg bg-white p-3 text-slate-800">${escapeHtml(result.message)}</p>`;
          return;
        }
        if (mode !== "manage") form.reset();
        updateTotal();
      } catch (error) {
        message.className =
          "food-preorder-message mt-3 text-sm font-semibold text-red-800";
        message.textContent = error.message;
      } finally {
        submitButton.disabled = false;
      }
    });

    const cancelButton = form.querySelector(".food-preorder-cancel");
    cancelButton?.addEventListener("click", async () => {
      if (
        !window.confirm("Möchtest du diese Reservierung wirklich stornieren?")
      )
        return;
      cancelButton.disabled = true;
      try {
        const result = await request(
          state.apiUrl,
          `/reservations/${encodeURIComponent(state.token)}`,
          { method: "DELETE" },
        );
        content.innerHTML = `<p class="mt-3 rounded-lg bg-white p-3 text-slate-800">${escapeHtml(result.message)}</p>`;
      } catch (error) {
        message.className =
          "food-preorder-message mt-3 text-sm font-semibold text-red-800";
        message.textContent = error.message;
        cancelButton.disabled = false;
      }
    });
  }

  async function initialise(root) {
    const apiUrl = root.dataset.apiUrl;
    const slug = root.dataset.eventSlug;
    if (!apiUrl || !slug) return;
    const status = root.querySelector(".food-preorder-status");
    const content = root.querySelector(".food-preorder-content");
    const url = new URL(window.location.href);
    let token = url.searchParams.get("food-order-token");

    try {
      if (token && url.searchParams.get("food-order-confirm") === "1") {
        status.textContent = "Bestätige Reservierung …";
        root.hidden = false;
        const result = await request(
          apiUrl,
          `/reservations/confirm/${encodeURIComponent(token)}`,
          { method: "POST" },
        );
        token = result.managementToken;
        url.searchParams.set("food-order-token", token);
        url.searchParams.delete("food-order-confirm");
        window.history.replaceState({}, "", url);
      }

      if (token) {
        const result = await request(
          apiUrl,
          `/reservations/${encodeURIComponent(token)}`,
        );
        renderOrderForm(root, {
          apiUrl,
          slug,
          token,
          ordering: result.ordering,
          reservation: result.reservation,
          mode: "manage",
        });
        return;
      }

      const ordering = await request(
        apiUrl,
        `/events/${encodeURIComponent(slug)}`,
      );
      if (ordering.closed) {
        root.hidden = true;
        return;
      }
      renderOrderForm(root, { apiUrl, slug, ordering, mode: "create" });
    } catch (error) {
      if (!token && error.code === "NOT_AVAILABLE") {
        root.hidden = true;
        return;
      }
      root.hidden = false;
      status.textContent = error.message;
      content.innerHTML = "";
    }
  }

  document
    .querySelectorAll("[data-food-preorder]")
    .forEach((root) => initialise(root));
</script>

<style>
  .food-preorder-honeypot {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>
