{
  "name": "astro-sco",
  "type": "module",
  "version": "0.9.2",
  "engines": {
    "node": ">=20.10.0 <23",
    "pnpm": ">=9.15.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "build:netlify": "cross-env DEPLOY_TARGET=netlify astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test:a11y": "playwright test tests/a11y.test.js",
    "test:a11y:headed": "playwright test tests/a11y.test.js --headed",
    "test:a11y:ui": "playwright test tests/a11y.test.js --ui",
    "test:visual": "playwright test tests/visual/ --config=playwright.visual.config.ts",
    "test:visual:update": "playwright test tests/visual/ --config=playwright.visual.config.ts --update-snapshots",
    "test:visual:headed": "playwright test tests/visual/ --config=playwright.visual.config.ts --headed",
    "test:visual:ui": "playwright test tests/visual/ --config=playwright.visual.config.ts --ui",
    "test:visual:report": "playwright show-report",
    "test:food-preorders": "node --test tests/food-preorders-api.test.mjs",
    "test:food-preorders:e2e": "playwright test --config=playwright.food-preorder.config.js",
    "directus:provision": "node scripts/directus/provision-schema.mjs",
    "directus:provision:sync": "node scripts/directus/provision-schema.mjs --sync",
    "directus:import:dry": "node scripts/directus/import-content.mjs --dry-run",
    "directus:import": "node scripts/directus/import-content.mjs --apply",
    "directus:import:assets:dry": "node scripts/directus/import-content.mjs --dry-run --rewrite-assets",
    "directus:import:assets": "node scripts/directus/import-content.mjs --apply --rewrite-assets",
    "directus:seed:dry": "node scripts/directus/import-content.mjs --dry-run --no-overwrite-existing",
    "directus:seed": "node scripts/directus/import-content.mjs --apply --no-overwrite-existing",
    "directus:seed:assets:dry": "node scripts/directus/import-content.mjs --dry-run --rewrite-assets --no-overwrite-existing",
    "directus:seed:assets": "node scripts/directus/import-content.mjs --apply --rewrite-assets --no-overwrite-existing",
    "directus:cleanup:dry": "node scripts/directus/cleanup-local-content.mjs",
    "directus:cleanup": "node scripts/directus/cleanup-local-content.mjs --apply",
    "guard:content": "node scripts/guard/block-content-edits.mjs",
    "guard:content:staged": "node scripts/guard/block-content-edits.mjs --staged",
    "unlighthouse": "unlighthouse-ci --site http://localhost:4328"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.0",
    "@astrojs/mdx": "^3.1.2",
    "@astrojs/rss": "^4.0.7",
    "@astrojs/sitemap": "^3.6.0",
    "@astrojs/tailwind": "^5.1.0",
    "@astrojs/vercel": "^7.7.2",
    "@vercel/speed-insights": "^1.3.1",
    "astro": "^4.11.3",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "sharp": "0.33.5",
    "tailwindcss": "^3.4.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.54.1",
    "@tailwindcss/typography": "^0.5.13",
    "@unlighthouse/cli": "^0.17.9",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "^3.3.2",
    "prettier-plugin-astro": "^0.14.0"
  },
  "packageManager": "pnpm@9.15.4+sha512.b2dc20e2fc72b3e18848459b37359a32064663e5627a51e4c74b2c29dd8e8e0491483c3abb40789cfd578bf362fb6ba8261b05f0387d76792ed6e23ea3b1b6a0"
}
