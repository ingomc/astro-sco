# ----------------------------------------------------------------------------
# Astro SCO – Environment variables
# Copy this file to `.env` for local dev. Never commit `.env` (see .gitignore).
# In Dokploy set these per application (prod vs. preview) under "Environment".
# ----------------------------------------------------------------------------

# --- Site ----------------------------------------------------------------
# Public URL of the deployed site. Used for canonical URLs, sitemap, RSS,
# OpenGraph and JSON-LD. Include the trailing slash.
SITE_URL=https://www.sc-oberfuellbach.de/

# Bare host (no protocol, no trailing slash). Used in JSON-LD structured
# data. Falls back to deriving from SITE_URL when unset.
SITE_HOST=sc-oberfuellbach.de

# Optional: set to "1" to disable Plausible analytics + Vercel Speed
# Insights. Recommended ON for any non-production deployment.
STAGING=0

# --- Directus (content source) ------------------------------------------
# Base URL of the Directus instance to fetch content from at build time.
# For staging/preview deployments point this at the staging Directus.
DIRECTUS_URL=https://cms.dart.ingomc.de

# Static bearer token with read access to all content collections.
DIRECTUS_TOKEN=replace-me

# Optional aliases (all equivalent to DIRECTUS_URL/TOKEN).
# When both are present, MCP_TOKEN takes precedence over DIRECTUS_TOKEN:
#   DIRECTUS_BASE_URL
#   DIRECTUS_PUBLIC_URL   (used as asset CDN base, falls back to DIRECTUS_URL)
#   DIRECTUS_API_URL      (force a specific REST root, e.g. /directus)
#   DIRECTUS_ACCESS_TOKEN
#   MCP                   (either a URL or a token)
#   MCP_TOKEN
#   ADMIN_EXPORT_TOKEN

# Content source mode. "directus" (default) builds from Directus.
# "astro" builds from local markdown in src/content/.
# "auto" tries Directus, falls back to Astro collections on error.
CONTENT_SOURCE=directus

# --- Öffentliche Essensvorbestellung --------------------------------------
# Vollständige URL der geschützten Directus-Endpunkt-Erweiterung. Diese
# Variable wird beim statischen Build in das Bestellmodul eingebettet.
# Die Collections mit Reservierungen bleiben weiterhin nicht öffentlich.
PUBLIC_FOOD_ORDERS_API_URL=https://cms.dart.ingomc.de/food-preorders

# Nur für ein abgeschottetes Test-CMS: bestätigt die eigene Testreservierung
# direkt im Browser statt per E-Mail. In Staging/Produktion immer false lassen.
ORDER_TEST_MODE=false

# --- Build adapter -------------------------------------------------------
# Leave empty to use the Vercel static adapter (writes .vercel/output/).
# Set to "netlify" to skip the adapter and produce a plain static dist/.
DEPLOY_TARGET=

# --- Extra Directus image domains (comma-separated) ----------------------
# Appended to the hard-coded list in astro.config.mjs. Add your staging
# Directus host here, e.g. cms-staging.dart.ingomc.de
EXTRA_IMAGE_DOMAINS=

# --- Comma-separated allow-list for the provision script -----------------
# Example: "veranstaltungen,berichte,settings"
LIMIT_COLLECTIONS=
